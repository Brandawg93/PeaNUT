{
  "name": "peanut",
  "version": "6.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "clean": "rm -rf .next .swc coverage test-results",
    "dev": "docker compose up -d && (next dev || true) && docker compose down",
    "dev:next": "next dev",
    "build": "next build",
    "build:local": "npm run build && cp -r .next/static .next/standalone/.next/",
    "build:analyze": "ANALYZE=true next build",
    "start": "node server.js",
    "start:local": "node .next/standalone/server.js",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint --cache",
    "lint:fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "format": "prettier --check . --cache",
    "format:fix": "prettier --write . --cache",
    "precheck": "concurrently \"npm run type-check\" \"lint-staged\"",
    "fullcheck": "concurrently \"npm run lint\" \"npm run stylelint\" \"npm run type-check\" \"npm run format\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "docker compose up -d && playwright test && WEB_USERNAME=admin WEB_PASSWORD=test123 playwright test && docker compose down",
    "test:all": "concurrently \"npm run test\" \"npm run test:e2e\"",
    "deploy:local": "./deploy.sh local",
    "deploy:test": "./deploy.sh test",
    "deploy:production": "./deploy.sh production",
    "telemetry": "next telemetry disable",
    "next-ws": "next-ws patch --yes",
    "prepare": "husky && npm run next-ws"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@influxdata/influxdb-client": "^1.35.0",
    "@influxdata/influxdb-client-apis": "^1.35.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.45.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-runtime-env": "^3.3.0",
    "next-themes": "^0.4.6",
    "next-ws": "^2.2.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "toad-scheduler": "^4.2.0",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.3.4",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^16.4.0",
    "next-swagger-doc": "^0.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "swagger-ui-react": "^5.32.15",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*": "eslint"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/utils": "^8.70.0"
    }
  }
}
